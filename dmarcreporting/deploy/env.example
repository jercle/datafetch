# The environment is dmarc-reporting's configuration. Every variable here can
# also be set in Azure App Configuration under datafetching.dmarcReporting
# (see ../README.md), where it wins over the variable:
# AZURE_APPCONFIG_ENDPOINT=https://<store>.azconfig.io
# AZURE_APPCONFIG_TENANT_ID=   AZURE_APPCONFIG_CLIENT_ID=   AZURE_APPCONFIG_CLIENT_SECRET=
# (or AZURE_APPCONFIG_MANAGED_IDENTITY=system)

# --- Entra ID app (Graph application permission: Mail.ReadWrite, admin-consented)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=
# Or, on AKS with workload identity (injected automatically by the webhook):
# AZURE_FEDERATED_TOKEN_FILE=/var/run/secrets/azure/tokens/azure-identity-token
# Sovereign clouds:
# AZURE_AUTHORITY_HOST=https://login.microsoftonline.us
# GRAPH_ENDPOINT=https://graph.microsoft.us

# --- Mailbox
DMARC_MAILBOX=dmarc-reports@contoso.com.au
DMARC_SOURCE_FOLDER=Inbox
DMARC_PROCESSED_FOLDER=Inbox/DMARC-Processed
DMARC_FAILED_FOLDER=Inbox/DMARC-Failed
DMARC_POST_PROCESS=move        # move | markread
DMARC_POLL_INTERVAL=5m
DMARC_BATCH_SIZE=25

# --- MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=dmarc
MONGODB_COLLECTION=dmarc_failures
MONGODB_INGEST_COLLECTION=dmarc_ingest
MONGODB_AGGREGATE_REPORTS_COLLECTION=dmarc_aggregate_reports
MONGODB_AGGREGATE_RECORDS_COLLECTION=dmarc_aggregate_records

# --- Enrichment
GEOIP_CITY_DB=./geoip/GeoLite2-City.mmdb
GEOIP_ASN_DB=./geoip/GeoLite2-ASN.mmdb
# Optional: ipinfo Lite (free) fills country/ASN gaps and adds the AS domain
IPINFO_TOKEN=
REVERSE_DNS=true
DNS_TIMEOUT=3s

# --- Privacy
REDACT_SUBJECT=false
STORE_ORIGINAL_HEADERS=false
STORE_RAW_FIELDS=true

HEALTH_ADDR=:8080
LOG_LEVEL=info

# --- Monitoring (run records, logs and heartbeat in MongoDB)
MONITORING_ENABLED=true
MONITORING_LOG_LEVEL=info            # minimum level stored: debug | info | warn | error
MONITORING_LOG_RETENTION_DAYS=30
MONITORING_RUN_RETENTION_DAYS=180
MONGODB_RUNS_COLLECTION=dmarc_collector_runs
MONGODB_LOGS_COLLECTION=dmarc_collector_logs
MONGODB_INSTANCES_COLLECTION=dmarc_collector_instances
# INSTANCE_NAME=dmarc-collector      # defaults to the hostname (pod name)

# --- Debugging
# Write messages in which no report was found here as .eml files
# DMARC_SAVE_UNPARSED_DIR=./unparsed
