{
  "mongo": {
    "uri": "mongodb://azstorage:CHANGE-ME@mongo.example.internal:27017/?authSource=admin&tls=true",
    "database": "azstorage",
    "ensureIndexes": true
  },
  "interval": "24h",
  "heartbeatInterval": "30s",
  "concurrency": { "tenants": 2, "accounts": 8, "containers": 4 },
  "retention": { "logsDays": 30, "runsDays": 90 },
  "logging": { "level": "info", "mongoLevel": "info", "format": "text" },

  "tenants": [
    {
      "tenantName": "Contoso Production",
      "tenantId": "00000000-0000-0000-0000-000000000000",
      "clientId": "11111111-1111-1111-1111-111111111111",
      "clientSecretEnv": "AZSTORAGE_CONTOSO_SECRET"
    },
    {
      "tenantName": "Fabrikam",
      "tenantId": "22222222-2222-2222-2222-222222222222",
      "clientId": "33333333-3333-3333-3333-333333333333",
      "clientSecretEnv": "AZSTORAGE_FABRIKAM_SECRET",
      "excludeSubscriptions": ["44444444-4444-4444-4444-444444444444"]
    }
  ],

  "collect": {
    "usage": true,
    "serviceBreakdown": true,
    "containers": true,
    "containerSizes": true,
    "disks": true
  },
  "containerSizes": {
    "snapshots": true,
    "versions": true,
    "deleted": true,
    "maxBlobs": 2000000,
    "timeout": "30m",
    "excludeAccounts": ["stdiag*"]
  }
}
