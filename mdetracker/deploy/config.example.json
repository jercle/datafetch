{
  "mongo": {
    "uri": "${MONGODB_URI}",
    "database": "mde",
    "vmCollection": "mde_vms",
    "runCollection": "mde_runs",
    "logCollection": "mde_logs",
    "logRetentionDays": 30
  },
  "interval": "6h",
  "mode": "vms",
  "matchByHostname": false,
  "hostnameFallback": true,
  "activeWindow": "48h",
  "inactiveAfter": "7d",
  "concurrency": 4,
  "writeOnPartial": false,
  "dumpDir": "",
  "dumpKeep": 5,
  "logLevel": "info",
  "mongoLogLevel": "info",
  "tenants": [
    {
      "name": "Contoso Prod",
      "tenantId": "00000000-0000-0000-0000-000000000001",
      "orgId": "11111111-1111-1111-1111-111111111111",
      "auth": {
        "type": "secret",
        "clientId": "22222222-2222-2222-2222-222222222222",
        "clientSecret": "${CONTOSO_MDE_SECRET}"
      }
    },
    {
      "name": "Fabrikam",
      "tenantId": "00000000-0000-0000-0000-000000000002",
      "orgId": "33333333-3333-3333-3333-333333333333",
      "auth": {
        "type": "workload",
        "clientId": "44444444-4444-4444-4444-444444444444"
      }
    },
    {
      "name": "Legacy GCC tenant",
      "enabled": false,
      "tenantId": "00000000-0000-0000-0000-000000000003",
      "orgId": "55555555-5555-5555-5555-555555555555",
      "apiBase": "https://api-gcc.securitycenter.microsoft.us",
      "scope": "https://api-gcc.securitycenter.microsoft.us/.default",
      "filter": "",
      "auth": {
        "type": "certificate",
        "clientId": "66666666-6666-6666-6666-666666666666",
        "certificatePath": "/secrets/legacy.pem"
      }
    }
  ]
}
