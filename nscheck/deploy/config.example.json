{
  "mongo": {
    "uri": "mongodb://nscheck:CHANGE-ME@mongo.example.internal:27017/?authSource=admin&tls=true",
    "database": "nscheck",
    "ensureIndexes": true
  },
  "interval": "1m",
  "heartbeatInterval": "30s",
  "timeout": "20s",
  "concurrency": 8,
  "retention": { "logsDays": 30, "runsDays": 14, "samplesDays": 30, "eventsDays": 180 },
  "logging": { "level": "info", "mongoLevel": "info", "format": "text" },

  "thresholds": {
    "cpu": { "warning": 75, "critical": 90 },
    "mgmtCpu": { "warning": 80, "critical": 95 },
    "memory": { "warning": 80, "critical": 90 },
    "disk": { "warning": 80, "critical": 90 },
    "certificateDays": { "warning": 30, "critical": 7 },
    "vserverHealthPercent": 100
  },
  "checks": {
    "hardware": true,
    "config": true,
    "ha": true,
    "interfaces": true,
    "vservers": true,
    "services": true,
    "certificates": true
  },
  "ignore": {
    "vservers": ["test-*"],
    "services": [],
    "certificates": ["ns-server-certificate", "ns-sftrust-certificate"],
    "interfaces": []
  },

  "defaults": {
    "username": "nscheck",
    "passwordEnv": "NSCHECK_PASSWORD",
    "tlsSkipVerify": false,
    "caFile": "/etc/ns-check/netscaler-ca.pem"
  },

  "appliances": [
    {
      "name": "ns-prod-01",
      "tenantName": "Contoso Production",
      "address": "https://10.10.0.11",
      "requireHA": true
    },
    {
      "name": "ns-prod-02",
      "tenantName": "Contoso Production",
      "address": "https://10.10.0.12",
      "requireHA": true
    },
    {
      "name": "ns-dmz-01",
      "tenantName": "Fabrikam",
      "address": "https://ns-dmz-01.fabrikam.example",
      "username": "monitor",
      "passwordEnv": "NSCHECK_FABRIKAM_PASSWORD",
      "tlsSkipVerify": true,
      "ignore": { "vservers": ["lb_decommissioned_*"] }
    }
  ]
}
